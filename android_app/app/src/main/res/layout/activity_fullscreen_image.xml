<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kw_media_bg"
    android:fitsSystemWindows="true"
    android:theme="@style/ThemeOverlay.KodiWise.AR">

    <ImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/full_screen_image"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/include_back_header" />

        <TextView
            android:id="@+id/tvCounter"
            style="@style/Widget.KodiWise.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:backgroundTint="@color/kw_ar_scrim"
            android:textColor="@color/kw_ar_on_scrim" />
    </LinearLayout>
</FrameLayout>
