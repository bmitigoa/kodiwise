<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by PredictionFormActivity and PropertyUploadActivity (bound by
     RealisticPropertyFields.kt). Must sit inside a vertical LinearLayout.
     All view ids are unchanged from the original form. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Size and type -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Widget.KodiWise.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_size_type" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/field_size"
                app:helperText="@string/optional"
                app:startIconContentDescription="@string/field_size"
                app:startIconDrawable="@drawable/ic_aspect_ratio"
                app:suffixText="@string/unit_sqm">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSqm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbDontKnowSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dont_know_size" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/field_property_type"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Was a RadioGroup; same ids, now single-select chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/rgPropertyType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:checkedChip="@id/rbApartment"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/rbApartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/type_apartment" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/rbHouse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/type_house" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/rbBedsitter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/type_bedsitter" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbFurnished"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/furnished" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Amenities (collapsed by default) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/headerAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.KodiWise.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_amenities" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/optional"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivAmenitiesChevron"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/cd_toggle_amenities"
                    android:src="@drawable/ic_expand_more" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbGenerator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/amenity_generator" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbBorehole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/amenity_borehole" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbCctv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/amenity_cctv" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbDsq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/amenity_dsq" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPlayArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/amenity_play_area" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbGarden"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/amenity_garden" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
