<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/include_back_header" />

        <!-- AR entry point hint (only when opened from an "AR" tab/button) -->
        <TextView
            android:id="@+id/tvArHint"
            style="@style/Widget.KodiWise.InfoChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/kw_primary_container"
            android:text="@string/ar_pick_listing"
            android:textColor="@color/kw_on_primary_container"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_view_in_ar"
            app:drawableTint="@color/kw_on_primary_container" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:hint="@string/search_listings"
            app:endIconMode="clear_text"
            app:startIconContentDescription="@string/search_listings"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBrowseProperties"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- Empty state (shown by the activity when the list is empty) -->
    <TextView
        android:id="@+id/tvEmpty"
        style="@style/Widget.KodiWise.EmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/empty_browse"
        android:visibility="gone"
        app:drawableTopCompat="@drawable/ic_inbox" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/loading"
        android:indeterminate="true"
        android:visibility="gone" />
</FrameLayout>
