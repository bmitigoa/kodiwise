<?xml version="1.0" encoding="utf-8"?>
<!-- AR gallery. Only the overlays are styled; the GL surface, the placed card
     (cardAnchor, positioned by ARViewActivity) and all ids are unchanged. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/arRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kw_media_bg"
    android:theme="@style/ThemeOverlay.KodiWise.AR">

    <android.opengl.GLSurfaceView
        android:id="@+id/glSurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Placed AR card -->
    <FrameLayout
        android:id="@+id/cardAnchor"
        android:layout_width="360dp"
        android:layout_height="270dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_ar_card"
        android:elevation="12dp"
        android:padding="4dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivArPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:contentDescription="@string/cd_ar_photo"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.KodiWise.Medium" />

        <!-- Shown instead of the photo when the listing has none -->
        <LinearLayout
            android:id="@+id/infoCard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/kw_on_surface" />

            <TextView
                android:id="@+id/tvCardArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/kw_on_surface_variant"
                app:drawableStartCompat="@drawable/ic_place_16"
                app:drawableTint="@color/kw_on_surface_variant" />

            <TextView
                android:id="@+id/tvCardRent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/kw_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCardBeds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/kw_on_surface" />

            <TextView
                android:id="@+id/tvCardRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/kw_on_surface_variant" />

            <TextView
                android:id="@+id/tvCardBand"
                style="@style/Widget.KodiWise.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/ar_card_no_photos"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/kw_on_surface_variant" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFullscreen"
            style="@style/Widget.KodiWise.Button.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:contentDescription="@string/cd_fullscreen"
            app:backgroundTint="@color/kw_ar_scrim"
            app:icon="@drawable/ic_fullscreen"
            app:iconTint="@color/kw_ar_on_scrim" />
    </FrameLayout>

    <!-- Overlays: one container fits the system bars so the camera stays full-bleed -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical">

            <include layout="@layout/include_back_header" />

            <LinearLayout
                android:id="@+id/topInfoBar"
                style="@style/Widget.KodiWise.ArPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvArTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/kw_ar_on_scrim" />

                <TextView
                    android:id="@+id/tvArLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/kw_ar_on_scrim_variant"
                    app:drawableStartCompat="@drawable/ic_place_16"
                    app:drawableTint="@color/kw_ar_on_scrim_variant" />

                <TextView
                    android:id="@+id/tvArMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/kw_ar_on_scrim_variant" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvArHint"
                style="@style/Widget.KodiWise.InfoChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/kw_ar_scrim"
                android:text="@string/ar_hint_place"
                android:textColor="@color/kw_ar_on_scrim"
                app:drawableStartCompat="@drawable/ic_view_in_ar"
                app:drawableTint="@color/kw_ar_on_scrim" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomControls"
            style="@style/Widget.KodiWise.ArPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrev"
                    style="@style/Widget.KodiWise.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/cd_previous_photo"
                    app:icon="@drawable/ic_chevron_left" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetAnchor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:text="@string/ar_replace_panel"
                    app:icon="@drawable/ic_refresh" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.KodiWise.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/cd_next_photo"
                    app:icon="@drawable/ic_chevron_right" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/thumbnailScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/thumbnailStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
