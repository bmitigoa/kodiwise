<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFactorLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvFactorEffect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="?attr/textAppearanceTitleSmall" />
    </LinearLayout>

    <!-- track; the bar's weight is its share of the longest bar (weightSum = 1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_factor_track"
        android:orientation="horizontal"
        android:weightSum="1">

        <View
            android:id="@+id/factorBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_factor_bar" />
    </LinearLayout>
</LinearLayout>
