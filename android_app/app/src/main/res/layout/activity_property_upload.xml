<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollUpload"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="6dp">

            <!-- Small subtitle only (no big heading) -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill in the details to add a new property"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="14dp" />

            <!-- Property Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Property Title"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_rounded"
                android:padding="12dp"
                android:hint="Enter property title"
                android:inputType="text"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginBottom="14dp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:background="@drawable/input_rounded"
                android:padding="12dp"
                android:hint="Enter property description"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginBottom="14dp" />

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="6dp" />

            <AutoCompleteTextView
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_rounded"
                android:padding="12dp"
                android:hint="Start typing a neighbourhood"
                android:inputType="text"
                android:completionThreshold="1"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginBottom="14dp" />

            <!-- Bedrooms -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bedrooms"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etBedrooms"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_rounded"
                android:padding="12dp"
                android:hint="Enter bedrooms"
                android:inputType="number"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginBottom="14dp" />

            <!-- Bathrooms -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bathrooms"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etBathrooms"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_rounded"
                android:padding="12dp"
                android:hint="Enter bathrooms"
                android:inputType="number"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginBottom="14dp" />

            <!-- Rent -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly Rent (KES)"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etPrice"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/input_rounded"
                android:padding="12dp"
                android:hint="Enter rent"
                android:inputType="numberDecimal"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:layout_marginBottom="14dp" />

            <include layout="@layout/include_realistic_property_fields" />

            <!-- Photo upload disabled: Firebase Storage is not enabled on the KodiWise
                 Firebase project (Spark/free plan) and will not be added. See project rules. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitUpload"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Upload Property"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_black_rounded"
                android:backgroundTint="@null"
                android:layout_marginBottom="12dp" />

            <!-- Status -->
            <TextView
                android:id="@+id/tvUploadStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#6B7280" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

    </LinearLayout>
</ScrollView>