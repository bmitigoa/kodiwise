rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: users/{uid} — each user can read/write only their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Property listings: any signed-in user can read (browse/search listings);
    // only the owner can create, update, or delete their own listing.
    match /properties/{propertyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.ownerId == request.auth.uid;

      // Media metadata under a property follows the parent property's ownership.
      match /media/{mediaId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
      }
    }

    // Performance-test scratch data (PerformanceTestActivity): no per-user ownership
    // field exists on these docs, so any signed-in user may read/write their own test runs.
    match /performance_tests/{testId} {
      allow read, write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
